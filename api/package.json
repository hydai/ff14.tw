{
  "name": "ff14-tw-treasure",
  "version": "1.0.0",
  "description": "Cloudflare Workers API for FF14.tw Treasure Map Room Collaboration",
  "main": "treasure-room-worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env development --local",
    "check:deploy": "wrangler deploy --dry-run --env development && wrangler deploy --dry-run --env production",
    "deploy": "wrangler deploy --env production",
    "tail": "wrangler tail --env production",
    "test": "node --test ../tests/treasure-room-api.test.js"
  },
  "keywords": [
    "cloudflare-workers",
    "ff14"
  ],
  "author": "hydai",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    }
  }
}
